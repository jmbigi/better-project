#!/usr/bin/env bash
# safe-curl — Wrapper determinista para bloquear pipes a bash/sh
# Uso: safe-curl [args...]  (bloquea si detecta pipe a bash/sh en SAFE_CURL_ORIGINAL_CMD)
#      safe-curl --allow-pipe [args...]  (permite pipe, solo para testing controlado)
#
# Integración: añadir al .bashrc/.zshrc:
#   alias curl='SAFE_CURL_ORIGINAL_CMD="$BASH_COMMAND" safe-curl'
#   alias wget='SAFE_WGET_ORIGINAL_CMD="$BASH_COMMAND" safe-wget'
# O usar DEBUG trap para capturar BASH_COMMAND antes de cada comando.

set -euo pipefail

ALLOW_PIPE=false
if [[ "${1:-}" == "--allow-pipe" ]]; then
    ALLOW_PIPE=true
    shift
fi

# Detectar si el comando original contiene pipe a bash/sh
# Se espera que el llamador establezca SAFE_CURL_ORIGINAL_CMD
ORIGINAL_CMD="${SAFE_CURL_ORIGINAL_CMD:-$*}"

# Patrones peligrosos: curl|wget seguido de pipe a bash/sh
if [[ "$ALLOW_PIPE" == "false" ]]; then
    if [[ "$ORIGINAL_CMD" =~ (curl|wget).*[|].*(bash|sh) ]]; then
        echo "❌ BLOQUEADO: Pipe a bash/sh detectado en: $ORIGINAL_CMD" >&2
        echo "   Regla P0.8: Nunca ejecutes código descargado sin revisarlo" >&2
        echo "   Usa --allow-pipe solo en testing controlado con revisión previa" >&2
        exit 1
    fi
fi

# Ejecutar curl normalmente
exec curl "$@"